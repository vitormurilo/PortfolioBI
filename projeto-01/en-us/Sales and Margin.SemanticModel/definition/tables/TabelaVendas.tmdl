table TabelaVendas
	lineageTag: 58a60e54-2ff0-4386-ab11-78f143c5e7a1

	measure 'Legacy Net Sales' = SUM(TabelaVendas[Valor_Liquido])
		formatString: "$"\ #,0.00;-"$"\ #,0.00;"$"\ #,0.00
		lineageTag: aade56c7-76a8-427d-a0d5-9e31dcd15a8b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Legacy Orders' = DISTINCTCOUNT(TabelaVendas[ID_Pedido])
		formatString: 0
		lineageTag: 7faa9d54-ceaa-438b-88b1-6a23e9135b7f

	measure 'Legacy Average Order Value' = DIVIDE(TabelaVendas[Legacy Net Sales],TabelaVendas[Legacy Orders],0)
		formatString: "$"\ #,0.00;-"$"\ #,0.00;"$"\ #,0.00
		lineageTag: c72c0a68-d60a-433b-959f-14fa09df24d1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Legacy Units Sold' = sum(TabelaVendas[Quantidade])
		formatString: 0
		lineageTag: 7eb9cd4f-4647-4d68-b9fd-35ef9e3fc681

